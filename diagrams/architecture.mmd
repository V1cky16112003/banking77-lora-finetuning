        EVALJSON["eval_runs/*.jsonl<br/>baseline + fine-tuned results"]
        EVALPY --> EVALCORE
        EVALCORE --> EVALJSON
    end

    subgraph SERVE["Serving Layer (local)"]
        SERVEPY["src/serve.py<br/>FastAPI /predict"]
        DEMOAPP["demo/app.py<br/>Gradio UI"]
        SMOKETEST["scripts/smoke_test.py<br/>post-deploy verification"]
        SERVEPY --> DEMOAPP
        SMOKETEST --> SERVEPY
    end

    subgraph REPORT["Reporting"]
        GENREPORT["scripts/generate_report.py<br/>results table, confusion<br/>heatmap, bootstrap CI"]
        README["README.md results table"]
        GENREPORT --> README
    end

    subgraph ORCH["Orchestration"]
        NOTEBOOK["notebooks/kaggle_orchestration.ipynb"]
    end

    subgraph CI["CI (GitHub Actions)"]
        TESTS["tests/<br/>test_config.py<br/>test_evaluate_core.py"]
    end

