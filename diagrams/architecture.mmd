        CKPT["Saved LoRA adapter<br/>checkpoints (Drive)"]
        BASEMODEL --> TRAINPY
        TRAINPY --> CKPT
    end

    subgraph EVAL["Evaluation Layer"]
        EVALCORE["src/evaluate_core.py<br/>pure eval logic:<br/>label parsing, metrics,<br/>confusion ranking<br/>(CI-tested, no ML deps)"]
