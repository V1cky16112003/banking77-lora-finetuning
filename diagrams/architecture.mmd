graph LR
    subgraph CONFIG["Config Layer"]
        TASKYAML["configs/task.yaml<br/>labels, prompt template,<br/>decoding config"]
        CONFIGPY["src/config.py<br/>TaskConfig loader"]
        TASKYAML --> CONFIGPY
    end

    subgraph DATA["Data Layer"]
        RAWDS["PolyAI/banking77<br/>(HF dataset)"]
        DATAPY["src/data.py<br/>frozen train/val/test split<br/>+ dataset integrity check<br/>(label-noise spot-check)"]
        RAWDS --> DATAPY
    end

    subgraph TRAIN["Training Layer (Colab / T4 GPU)"]
        BASEMODEL["Qwen2.5-1.5B-Instruct"]
